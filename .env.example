# talk-sip-bridge - environment template
#
# Copy to .env and fill in. docker-compose passes this file straight to the
# container, so parseable settings like BRIDGE_DIALIN_NUMBERS follow the
# upstream syntax. See docs/CONFIG.md in the upstream repository for the
# full reference of every variable.

# Required. An IP address of THIS host the container can bind SIP/RTP to
# and that the gateway can route to. With the default host networking in
# docker-compose.yml.example this is the host's LAN address, e.g. 192.0.2.10.
BRIDGE_LOCAL_IP=

# Required. The SIP account: username, password, and the gateway/registrar
# address (e.g. a FRITZ!Box or a provider's trunk).
BRIDGE_SIP_USER=
BRIDGE_SIP_PASS=
BRIDGE_GATEWAY_HOST=

# udp (default) or tcp. A FRITZ!Box drops UDP registrations without a word;
# TCP-only providers are common. Set to tcp if the line never registers.
#BRIDGE_SIP_TRANSPORT=udp

# Required, the Talk side. BRIDGE_WS_URL points at the standalone signaling
# server (High Performance Backend), not Nextcloud itself.
BRIDGE_WS_URL=
BRIDGE_INTERNAL_SECRET=
BRIDGE_BACKEND_URL=

# ---------------------------------------------------------------------------
# DIAL-IN (phone -> Talk). Built into the bridge but off by default: a call
# is only answered when it reaches a number the bridge owns, so outgoing
# calls (Talk -> phone) need none of this. Recipe 1 and/or 2 below are the
# normal ways in; Recipe 3 is a fallback and needs the notify account.
# All three can be combined on one line.
# ---------------------------------------------------------------------------

# Recipe 1 - one number, one specific conversation (direct dial-in).
# Maps "what the INVITE announces as the called number" to "the phone
# number Talk knows for that conversation":
#   BRIDGE_DIALIN_NUMBERS=<announced>=<talk number>[, <announced>=<talk number>]
#   e.g. BRIDGE_DIALIN_NUMBERS=**622=+49 30 1234567
# Register each number in Nextcloud too:
#   occ talk:phone-number:add "<talk number>" "<room token>"
# A number listed here belongs to the bridge and is answered automatically.
#BRIDGE_DIALIN_NUMBERS=

# Recipe 2 - one number, any meeting (conference). The bridge answers and
# asks the caller for the meeting id (and PIN if there is one). A regex
# deciding who may reach it - empty lets everyone dial in:
#   BRIDGE_CONFERENCE_NUMBERS=<number>
#   BRIDGE_CONFERENCE_CALLERS=^\*\*[0-9]+$
#BRIDGE_CONFERENCE_NUMBERS=
#BRIDGE_CONFERENCE_CALLERS=

# Recipe 3 - fallback room for any number not matched above. Only works if
# the line also has a notify account (below); otherwise the caller is left
# ringing. For a line whose number is also a person's phone this would pick
# up their calls, which is what BRIDGE_AUTO_ANSWER below guards.
#BRIDGE_DEFAULT_ROOM=

# Notify account: a Nextcloud user that rings the fallback room so someone
# in Talk can pick up. Value is an app password (Settings -> Security ->
# "Create new app password"), NOT the login password. Needed only by
# Recipe 3.
#BRIDGE_NOTIFY_USER=
#BRIDGE_NOTIFY_APP_PASSWORD=

# Only set true if you want an inbound call answered even when it is not
# clearly the bridge's (e.g. a fallback room on a number that might belong
# to a person). Default false: leave such calls ringing.
#BRIDGE_AUTO_ANSWER=false

# On startup the entrypoint checks the control API and toggles on any
# unregistered line, so dial-in works on a fresh/cleared state dir. Default
# true. Set false to keep the upstream behaviour of leaving the line off
# until it is toggled explicitly (e.g. from the Nextcloud app).
#BRIDGE_AUTO_REGISTER=true

# Where the control API listens. Nextcloud reaches it on 127.0.0.1:8765 for
# a same-host deployment. If Nextcloud runs elsewhere (e.g. its own Docker
# network), bind an address that container/host can reach - a private
# Docker bridge gateway address, never a public interface.
BRIDGE_CONTROL_BIND=127.0.0.1
BRIDGE_CONTROL_PORT=8765